# Copiar a foundry-spoke.env y ajustar valores reales.

AZURE_ENV_NAME=foundry-spoke-dev
AZURE_LOCATION=eastus2
AZURE_AI_FOUNDRY_LOCATION=eastus2
AZURE_PSQL_LOCATION=eastus2
AZURE_COSMOS_LOCATION=eastus2
AZURE_SEARCH_LOCATION=eastus2
AZURE_SPEECH_LOCATION=eastus2

# Principio base del patrón hub-spoke integrado
DEPLOYMENT_MODE=ailz-integrated
NETWORK_ISOLATION=true

# Observabilidad compartida
EXISTING_LOG_ANALYTICS_WORKSPACE_RESOURCE_ID=
EXISTING_APPLICATION_INSIGHTS_RESOURCE_ID=
EXISTING_APPLICATION_INSIGHTS_CONNECTION_STRING=

# Red corporativa
USE_EXISTING_VNET=false
DEPLOY_SUBNETS=true
SIDE_BY_SIDE=true
EXISTING_VNET_RESOURCE_ID=
HUB_INTEGRATION_HUB_VNET_RESOURCE_ID=
HUB_INTEGRATION_CREATE_HUB_PEERING=true
HUB_INTEGRATION_PEERING_ALLOW_GATEWAY_TRANSIT=false
HUB_INTEGRATION_PEERING_USE_REMOTE_GATEWAYS=false

# Egress
DEPLOY_AZURE_FIREWALL=false
HUB_INTEGRATION_EGRESS_NEXT_HOP_IP=
HUB_INTEGRATION_EXISTING_ROUTE_TABLE_RESOURCE_ID=

# Acceso administrativo
DEPLOY_JUMPBOX=true
DEPLOY_BASTION=false
EXISTING_BASTION_RESOURCE_ID=
DEPLOY_NAT_GATEWAY=true
EXISTING_NAT_GATEWAY_RESOURCE_ID=
DEPLOY_SOFTWARE=false

# DNS privado reutilizable desde hub
POLICY_MANAGED_PRIVATE_DNS=false
EXISTING_PRIVATE_DNS_ZONE_COGSVCS_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_OPENAI_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_AISERVICES_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_SEARCH_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_COSMOS_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_BLOB_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_KEYVAULT_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_APPCONFIG_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_CONTAINERAPPS_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_ACR_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_AZUREMONITOR_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_OMSOPSINSIGHTS_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_ODSOPSINSIGHTS_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_AZUREAUTOMATION_RESOURCE_ID=
EXISTING_PRIVATE_DNS_ZONE_APPINSIGHTS_RESOURCE_ID=
DNS_ZONE_LINK_SUFFIX=

# Features
DEPLOY_SEARCH_SERVICE=true
DEPLOY_STORAGE_ACCOUNT=true
DEPLOY_KEY_VAULT=true
DEPLOY_LOG_ANALYTICS=true
ENABLE_PRIVATE_LOG_ANALYTICS=true
DEPLOY_GROUNDING_WITH_BING=false
DEPLOY_SPEECH_SERVICE=false
DEPLOY_ACR_TASK_AGENT_POOL=false
ENABLE_AGENTIC_RETRIEVAL=false
