# Copiar a citadel-hub.env y ajustar valores reales.

AZURE_ENV_NAME=citadel-hub-dev
AZURE_LOCATION=eastus2
APIC_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-ai-citadel-hub-dev

# Networking
USE_EXISTING_VNET=false
VNET_NAME=vnet-ai-citadel-dev
VNET_ADDRESS_PREFIX=10.170.0.0/24
APIM_SUBNET_PREFIX=10.170.0.0/26
PRIVATE_ENDPOINT_SUBNET_PREFIX=10.170.0.64/26
FUNCTION_APP_SUBNET_PREFIX=10.170.0.128/26
AGENT_SUBNET_PREFIX=10.170.0.192/26
FOUNDRY_NETWORK_INJECTION_ENABLED=true

# Si USE_EXISTING_VNET=true, completar estos valores:
EXISTING_VNET_RG=
APIM_SUBNET_NAME=
PRIVATE_ENDPOINT_SUBNET_NAME=
FUNCTION_APP_SUBNET_NAME=
AGENT_SUBNET_NAME=
DNS_ZONE_RG=
DNS_SUBSCRIPTION_ID=

# Observabilidad
USE_EXISTING_LOG_ANALYTICS=true
EXISTING_LOG_ANALYTICS_NAME=
EXISTING_LOG_ANALYTICS_RG=
EXISTING_LOG_ANALYTICS_SUBSCRIPTION_ID=

# Seguridad / exposición
APIM_NETWORK_TYPE=Internal
APIM_V2_USE_PRIVATE_ENDPOINT=true
APIM_V2_PUBLIC_NETWORK_ACCESS=false
AI_FOUNDRY_EXTERNAL_NETWORK_ACCESS=Disabled
KEY_VAULT_EXTERNAL_NETWORK_ACCESS=Disabled
COSMOS_DB_PUBLIC_ACCESS=Disabled
EVENTHUB_NETWORK_ACCESS=Enabled

# Features
ENABLE_UNIFIED_AI_API=true
ENABLE_API_CENTER=true
ENABLE_MANAGED_REDIS=true
ENABLE_AI_MODEL_INFERENCE=true
ENABLE_DOCUMENT_INTELLIGENCE=false
ENABLE_AZURE_AI_SEARCH=false
ENABLE_PII_REDACTION=true
AZURE_ENTRA_AUTH=false

# Sizing
APIM_SKU=StandardV2
APIM_SKU_UNITS=1
COSMOS_DB_RUS=400
LOGIC_APPS_SKU_CAPACITY_UNITS=1
REDIS_SKU_NAME=Balanced_B1
REDIS_SKU_CAPACITY=1
