    "workload": { "value": "agent" },
    "tags": { "value": { "patron": "foundry-agent", "organizacion": "CAF" } },
    "prefixes": { "value": {
      "vnet": "REEMPLAZAR_CIDR_IPAM",
      "foundry": "REEMPLAZAR_CIDR_IPAM",
      "containers": "REEMPLAZAR_CIDR_IPAM",
      "appGateway": "REEMPLAZAR_CIDR_IPAM",
