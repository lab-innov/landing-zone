AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-ai-gov-hub-dev
ENVIRONMENT=dev

VNET_NAME=vnet-ai-gov-dev
VNET_ADDRESS_PREFIX=10.170.0.0/24
APIM_SUBNET_NAME=snet-apim
APIM_SUBNET_PREFIX=10.170.0.0/26
PRIVATE_ENDPOINT_SUBNET_NAME=snet-private-endpoints
PRIVATE_ENDPOINT_SUBNET_PREFIX=10.170.0.64/26
INTEGRATION_SUBNET_NAME=snet-integration
INTEGRATION_SUBNET_PREFIX=10.170.0.128/26

DEPLOY_PRIVATE_DNS_ZONES=true
DEPLOY_PRIVATE_ENDPOINTS=true

DEPLOY_EVENT_HUB=true
EVENTHUB_NAMESPACE_NAME=
EVENTHUB_NAME=ai-usage

DEPLOY_COSMOS_DB=true
COSMOS_DB_ACCOUNT_NAME=
COSMOS_DB_DATABASE_NAME=governance
COSMOS_DB_CONTAINER_NAME=usage

DEPLOY_AI_FOUNDRY=true
AI_FOUNDRY_ACCOUNT_NAME=
AI_FOUNDRY_PROJECT_NAME=governance-project
AI_FOUNDRY_CUSTOM_SUBDOMAIN=
AI_FOUNDRY_DISABLE_LOCAL_AUTH=true

APIM_NAME=
APIM_PUBLISHER_NAME=Platform Team
APIM_PUBLISHER_EMAIL=platform@example.com
APIM_SKU_NAME=Developer
APIM_SKU_CAPACITY=1
APIM_VNET_TYPE=External
APIM_PUBLIC_NETWORK_ACCESS=Enabled
ENABLE_APIM_PRIVATE_ENDPOINT=false
